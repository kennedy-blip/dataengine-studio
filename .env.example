# Optional database connectors. The core local-first workspace needs no env vars.
# Use dedicated READ-ONLY database users and TLS. Never commit real values.
DATAENGINE_POSTGRES_URL=
DATAENGINE_MYSQL_URL=
DATAENGINE_MONGODB_URL=

# Required to enable database connectors. Generate a random secret >= 32 chars.
# Enter this value in Import data -> Database -> Workspace access token.
DATAENGINE_ACCESS_TOKEN=

# Private/loopback database hosts are blocked by default.
# Enable only when the deployment owner explicitly intends private network access.
DATAENGINE_ALLOW_PRIVATE_DATABASES=false
